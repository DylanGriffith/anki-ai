<div class="page-header">
  <h1><%= @deck.name %></h1>
  <span class="deck-meta"><%= @card.note.note_type.name %></span>
</div>

<%= form_with url: study_answer_deck_path(@deck), method: :post,
      data: { controller: "study", turbo: false } do %>
  <%= hidden_field_tag :card_id, @card.id %>
  <div class="study-card anki-card">
    <style><%= CardHtml.css(@note_type) %></style>
    <%= @question_html %>
    <hr class="answer-divider">
    <%= @answer_html %>
  </div>
  <div class="study-answer">
    <%= button_tag "Again <small>#{@intervals[0]}</small>".html_safe, name: "rating", value: 1, class: "btn btn--danger" %>
    <%= button_tag "Hard <small>#{@intervals[1]}</small>".html_safe, name: "rating", value: 2, class: "btn btn--secondary" %>
    <%= button_tag "Good <small>#{@intervals[2]}</small>".html_safe, name: "rating", value: 3, class: "btn" %>
    <%= button_tag "Easy <small>#{@intervals[3]}</small>".html_safe, name: "rating", value: 4, class: "btn btn--easy" %>
  </div>
<% end %>
