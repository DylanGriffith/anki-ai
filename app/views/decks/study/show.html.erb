<% content_for :head do %>
  <%# Restore via back button should re-render fresh, not a stale session. %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="page-header">
  <h1><%= @deck.name %></h1>
  <span class="deck-meta"><%= pluralize(@counts[:due_now], "due") %> · <%= pluralize(@counts[:new_remaining], "new") %></span>
  <%= link_to "Done", deck_path(@deck), class: "btn btn--secondary" %>
</div>

<% if @cards.any? %>
  <%# Both sides of every queued card, pre-rendered (see Reviewing::SessionSerializer).
      "<" is escaped as \u003c so the JSON can never break out of the script tag. %>
  <script type="application/json" id="study-session-data"><%= @session.to_json.gsub("<", '\u003c').html_safe %></script>
  <style><%= @session["css"].to_s.html_safe %></style>

  <div id="study-session">
    <div class="study-card anki-card"></div>
    <div class="answer-bar"></div>
    <p class="sync-status" hidden></p>
    <noscript>
      <div class="card"><p><strong>JavaScript is required to study.</strong> The session runs in your browser so reviewing also works offline.</p></div>
    </noscript>
  </div>
<% elsif @counts[:next_due_at] %>
  <div class="card">
    <p><strong>No cards ready right now.</strong></p>
    <p class="muted">Next card is due <%= distance_of_time_in_words_to_now(@counts[:next_due_at]) %> from now.</p>
    <p class="muted">Today: <%= @counts[:reviews_done_today] %> reviews, <%= @counts[:new_done_today] %> new cards.</p>
    <%= link_to "Check again", study_deck_path(@deck), class: "btn btn--secondary" %>
  </div>
<% else %>
  <div class="card">
    <p><strong>Congratulations!</strong> Nothing left to study in this deck.</p>
    <p class="muted">
      Today: <%= @counts[:reviews_done_today] %> reviews, <%= @counts[:new_done_today] %> new cards.
    </p>
    <%= link_to "Back to deck", deck_path(@deck), class: "btn btn--secondary" %>
  </div>
<% end %>
