<div class="page-header">
  <h1><%= @deck.name %> — cards</h1>
  <% if @deck.editable_by?(current_user) %>
    <%= link_to "Add card", new_card_deck_path(@deck), class: "btn" %>
  <% end %>
  <%= link_to "Back", deck_path(@deck), class: "btn btn--secondary" %>
</div>

<% if @cards.any? %>
  <ul class="deck-list">
    <% @cards.each do |card| %>
      <li>
        <span class="card-summary"><%= truncate(strip_tags(card.note.fields.first.to_s), length: 60) %></span>
        <span class="deck-meta"><%= card.note.note_type.name %></span>
        <% if card.suspended? %><span class="badge">suspended</span><% end %>
        <span class="deck-meta"><%= card.state_for(current_user)&.state&.gsub("_", " ") || "new" %></span>
      </li>
    <% end %>
  </ul>
  <div class="actions">
    <% if @offset.positive? %>
      <%= link_to "« Previous", cards_deck_path(@deck, offset: [ @offset - PAGE_SIZE, 0 ].max), class: "btn btn--secondary" %>
    <% end %>
    <% if @more %>
      <%= link_to "Next »", cards_deck_path(@deck, offset: @offset + PAGE_SIZE), class: "btn btn--secondary" %>
    <% end %>
  </div>
<% else %>
  <p class="empty">No cards in this deck yet.</p>
<% end %>
