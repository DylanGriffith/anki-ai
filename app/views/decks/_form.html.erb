<%= form_with model: deck, data: { turbo: false }, class: "card card--narrow" do |f| %>
  <% if deck.errors.any? %>
    <div class="flash flash--alert">
      <%= deck.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= f.label :name %>
  <%= f.text_field :name, autofocus: true, required: true %>

  <%= f.label :description %>
  <%= f.text_area :description, rows: 3 %>

  <%= f.label :visibility, "Visibility" %>
  <%= f.select :visibility, [ [ "Private", "private" ], [ "Public", "public" ] ] %>

  <div class="field-pair">
    <div>
      <%= f.label :new_per_day, "New cards per day" %>
      <%= f.number_field :new_per_day, min: 0, max: 9999 %>
    </div>
    <div>
      <%= f.label :reviews_per_day, "Reviews per day" %>
      <%= f.number_field :reviews_per_day, min: 0, max: 9999 %>
    </div>
  </div>

  <%= f.submit deck.persisted? ? "Save deck" : "Create deck" %>
  <%= link_to "Cancel", deck.persisted? ? deck : decks_path, class: "btn btn--secondary" %>
<% end %>
