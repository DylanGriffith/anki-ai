<div class="page-header">
  <h1>Decks</h1>
  <%= link_to "Import .apkg", import_decks_form_path, class: "btn btn--secondary" %>
  <%= link_to "New deck", new_deck_path, class: "btn" %>
</div>

<% if @decks.any? %>
  <ul class="deck-list">
    <% @decks.each do |deck| %>
      <li>
        <%# One click on the deck starts studying; details live behind the
            button so the common action needs no intermediate page. %>
        <%= link_to deck.name, study_deck_path(deck), class: "deck-name" %>
        <span class="deck-meta"><%= deck.is_public? ? "public" : "private" %></span>
        <span class="deck-meta">
          <% due = @due_counts[deck.id].to_i %>
          <% new_left = [ @new_counts[deck.id].to_i, deck.new_per_day ].min %>
          <% if due.positive? %>
            <strong class="due-count"><%= due %> due</strong>
          <% end %>
          <% if new_left.positive? && deck.cards.exists? %>
            <%= new_left %> new
          <% end %>
        </span>
        <%= link_to "Details", deck, class: "btn btn--secondary btn--compact", "aria-label": "Details for #{deck.name}" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="empty">No decks yet. Create one, or import an Anki deck (<code>.apkg</code>).</p>
<% end %>
