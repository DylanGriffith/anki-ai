<h1>New deck</h1>

<%= form_with model: @deck, data: { turbo: false }, class: "card card--narrow" do |f| %>
  <% if @deck.errors.any? %>
    <div class="flash flash--alert">
      <%= @deck.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= f.label :name %>
  <%= f.text_field :name, autofocus: true, required: true %>

  <%= f.label :description %>
  <%= f.text_area :description, rows: 3 %>

  <%= f.label :visibility, "Visibility" %>
  <%= f.select :visibility, [ [ "Private", "private" ], [ "Public", "public" ] ] %>

  <%= f.submit "Create deck" %>
  <%= link_to "Cancel", decks_path, class: "btn btn--secondary" %>
<% end %>
