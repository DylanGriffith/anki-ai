<h1>Sign in</h1>

<%= form_with url: login_path, method: :post, data: { turbo: false }, class: "card card--narrow" do |f| %>
  <%= f.label :name, "Username" %>
  <%= f.text_field :name, value: params[:name], autofocus: true, autocomplete: "username", required: true %>

  <%= f.label :password, "Password" %>
  <%= f.password_field :password, autocomplete: "current-password", required: true %>

  <%= f.submit "Sign in" %>
<% end %>
