<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Anki AI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="topnav">
      <%= link_to "Anki AI", root_path, class: "brand" %>
      <span class="spacer"></span>
      <% if current_user %>
        <span class="who"><%= current_user.name %></span>
        <%= button_to "Sign out", logout_path, method: :delete, class: "linklike", form: { data: { turbo: false } } %>
      <% end %>
    </nav>

    <% if flash[:notice] %><div class="flash flash--notice"><%= flash[:notice] %></div><% end %>
    <% if flash[:alert] %><div class="flash flash--alert"><%= flash[:alert] %></div><% end %>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
