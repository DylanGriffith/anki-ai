<div class="page-header">
  <h1>AI deck generation</h1>
  <span class="generation-status">
    <span class="status-dot status-dot--<%= status_tone %>" title="<%= @generation.status %>"></span>
    <%= @generation.status %> · <%= @generation.model %>
    <% if @generation.turn_count.positive? %>
      · turn <%= @generation.turn_count %>
    <% end %>
  </span>
</div>

<div class="card">
  <div class="deck-stats">
    <div><strong><%= @generation.journal.count { |e| e["type"] == "tool" } %></strong> tool calls</div>
    <% if @generation.deck %>
      <div><strong><%= @generation.deck.notes.count %></strong> notes</div>
    <% end %>
  </div>
</div>

<p class="deck-description"><strong>Prompt:</strong> <%= @generation.prompt %></p>

<% if @generation.running? || @generation.pending? %>
  <p class="muted" data-generation-status="<%= @generation.status %>">
    The AI agent is working… this page refreshes every couple of seconds.
  </p>
<% end %>

<% if @generation.failed? %>
  <p class="flash flash--alert">
    Generation failed: <%= @generation.error %>
  </p>
<% end %>

<div class="card transcript">
  <% @generation.journal.each_with_index do |entry, i| %>
    <% case entry["type"]
       when "assistant" %>
      <%# Collapsed by default: just the role in the summary %>
      <details class="transcript-entry transcript-entry--assistant">
        <summary>
          assistant<% if entry["streaming"] %> <span class="muted">thinking…</span><% end %>
          <% if entry["tool_calls"].present? %>
            <span class="muted">→ <%= entry["tool_calls"].map { |c| c.is_a?(String) ? c : c["name"] }.compact.join(", ") %></span>
          <% end %>
        </summary>
        <% if entry["text"].present? %>
          <div><%= entry["text"] %></div>
        <% end %>
      </details>
    <% when "tool" %>
      <%# Collapsed by default: just the tool name (plus an error marker) %>
      <details class="transcript-entry transcript-entry--tool <%= entry["error"] ? "transcript-entry--error" : "" %>">
        <summary><%= entry["name"] %><% if entry["error"] %> ✗<% end %></summary>
        <div class="muted">arguments</div>
        <pre><%= JSON.pretty_generate(entry["arguments"]) %></pre>
        <div class="muted">result</div>
        <pre><%= JSON.pretty_generate(entry["result"]) %></pre>
      </details>
    <% else %>
      <div class="transcript-entry transcript-entry--status">
        <span class="muted">· <%= [ entry["text"], entry["summary"], entry["deck"], entry["error"] ].compact.join(" — ") %></span>
      </div>
    <% end %>
  <% end %>
</div>

<div class="actions">
  <% if @generation.deck %>
    <%= link_to "Open deck", deck_path(@generation.deck), class: "btn" %>
  <% end %>
  <%= link_to "Back to decks", decks_path, class: "btn btn--secondary" %>
</div>

<script>
  // Keep the newest entry in view while the transcript grows.
  const box = document.querySelector(".transcript")
  if (box) box.scrollTop = box.scrollHeight
  <% if @generation.pending? || @generation.running? %>
    // Poll: a plain Turbo replace-visit, no frameworks, no websocket.
    setTimeout(() => {
      if (window.Turbo) { Turbo.visit(window.location.href, { action: "replace" }) }
      else { window.location.reload() }
    }, 2000)
  <% end %>
</script>
